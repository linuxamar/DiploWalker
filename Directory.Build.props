<Project>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <!--
      Traitement des avertissements du compilateur en erreurs : toute
      nouvelle alerte fait échouer le build (qualité maintenue par le CI).
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Désactive la référence implicite FSharp.Core du SDK .NET 10.
      La version est pinnée via CentralPackageTransitivePinningEnabled
      dans Directory.Packages.props (évite le conflit MSB3277 entre
      la version SDK et la version NuGet 10.1.400).
    -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Plateformes autorisées : x64 ou x86 exclusivement.
      AnyCPU est interdit — les binaires Diplo ciblent containerd/WSL2 nativement.
      Par défaut x64 ; override avec -p:Platform=x86
    -->
    <Platforms>x64;x86</Platforms>
    <Platform>x64</Platform>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Analyseurs de code Microsoft — activés pour tous les projets.
      Level=latest   : dernière version des règles Roslyn.
      Mode=Recommended : règle par défaut recommandée (pas trop strict).
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      HighEntropyVA — layout virtuel à haute entropie (ASLR 64-bit).
      Sécurise les binaires contre les attaques de type buffer overflow.
    -->
    <HighEntropyVA>true</HighEntropyVA>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Audit NuGet : activé pour détecter les vulnérabilités des dépendances
      transitives (CVE connues). Mode=all : analyse des dépendances directes
      et transitives.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Strong-name signing : toutes les assemblies Diplo sont signées avec la clé eng/Diplo.snk.
    -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)eng\Diplo.snk</AssemblyOriginatorKeyFile>
    <KeyFile>$(MSBuildThisFileDirectory)eng\Diplo.snk</KeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Les paquets framework (FSharp.Core, Cryptography.Pkcs, Cryptography.Xml)
      ne nécessitent plus de PackageReference explicite — les versions sont
      pinnées au niveau transitive via CentralPackageTransitivePinningEnabled
      dans Directory.Packages.props (corrige NU1510).
    -->
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
