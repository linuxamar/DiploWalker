<Project>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <!--
      Traitement des avertissements du compilateur en erreurs : toute
      nouvelle alerte fait échouer le build (qualité maintenue par le CI).
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Plateformes autorisées : x64 ou x86 exclusivement.
      AnyCPU est interdit — les binaires Diplo ciblent containerd/WSL2 nativement.
      Par défaut x64 ; override avec -p:Platform=x86
    -->
    <Platforms>x64;x86</Platforms>
    <Platform>x64</Platform>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Analyseurs de code Microsoft — activés pour tous les projets.
      Level=latest   : dernière version des règles Roslyn.
      Mode=Recommended : règle par défaut recommandée (pas trop strict).
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      HighEntropyVA — layout virtuel à haute entropie (ASLR 64-bit).
      Sécurise les binaires contre les attaques de type buffer overflow.
    -->
    <HighEntropyVA>true</HighEntropyVA>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      NU1510 : avertissement inoffensif pour les projets sans dépendance transitives
      sur les packages de sécurité globaux (Pkcs / Xml).
    -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Forcer la résolution des versions transitives vulnérables
      (apportées par System.ServiceModel.Primitives).
      Les versions sont définies dans Directory.Packages.props.
    -->
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Strong-name signing : toutes les assemblies Diplo sont signées avec la clé eng/Diplo.snk.
    -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)eng\Diplo.snk</AssemblyOriginatorKeyFile>
    <KeyFile>$(MSBuildThisFileDirectory)eng\Diplo.snk</KeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

</Project>
