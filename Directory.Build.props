<Project>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <!--
      Traitement des avertissements du compilateur en erreurs : toute
      nouvelle alerte fait Ã©chouer le build (qualitÃ© maintenue par le CI).
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      DÃ©sactive la rÃ©fÃ©rence implicite FSharp.Core du SDK .NET 10.
      La version est pinnÃ©e via CentralPackageTransitivePinningEnabled
      dans Directory.Packages.props (Ã©vite le conflit MSB3277 entre
      la version SDK et la version NuGet 10.1.400).
    -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Plateformes autorisÃ©es : x64 ou x86 exclusivement.
      AnyCPU est interdit â€” les binaires Diplo ciblent containerd/WSL2 nativement.
      Par dÃ©faut x64 ; override avec -p:Platform=x86
    -->
    <Platforms>x64;x86</Platforms>
    <Platform>x64</Platform>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Analyseurs de code Microsoft â€” activÃ©s pour tous les projets.
      Level=latest   : derniÃ¨re version des rÃ¨gles Roslyn.
      Mode=Recommended : rÃ¨gle par dÃ©faut recommandÃ©e (pas trop strict).
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      HighEntropyVA â€” layout virtuel Ã  haute entropie (ASLR 64-bit).
      SÃ©curise les binaires contre les attaques de type buffer overflow.
    -->
    <HighEntropyVA>true</HighEntropyVA>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Audit NuGet : activÃ© pour dÃ©tecter les vulnÃ©rabilitÃ©s des dÃ©pendances
      transitives (CVE connues). Mode=all : analyse des dÃ©pendances directes
      et transitives.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <!--
      Strong-name signing : sous Windows, toutes les assemblies Diplo sont signées avec la clé eng/DiploWalker.snk.
    -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)eng\DiploWalker.snk</AssemblyOriginatorKeyFile>
    <KeyFile>$(MSBuildThisFileDirectory)eng\DiploWalker.snk</KeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Les paquets framework (FSharp.Core, Cryptography.Pkcs, Cryptography.Xml)
      ne nÃ©cessitent plus de PackageReference explicite â€” les versions sont
      pinnÃ©es au niveau transitive via CentralPackageTransitivePinningEnabled
      dans Directory.Packages.props (corrige NU1510).
    -->
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>

