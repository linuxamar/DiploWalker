## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# Visual Studio
.vs/

# Visual Studio launch settings
**/Properties/launchSettings.json

# MSBuild Binary and Structured Log
*.binlog

# Journaux d'exécution à la racine (accidents récurrents)
*.log

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Temporary test/debug directories
test-repro/

# Installer artifacts
Diplo-Setup-*.exe

# Code signing certificate (development)
eng/Diplo_dev.pfx

# Publications locales
publish/
publish-cli/

# Raccourci de lancement local de l'agent (non versionné)
ai.cmd

# PKI locale : les clés privées et CSR ne doivent jamais être versionnées
certificates/**/private/
certificates/**/csr/
certificates/**/db/newcerts/
certificates/**/db/index.txt
certificates/**/db/index.txt.*
certificates/**/db/*.old

# Certificats de signature de code : clés privées, CSR et PFX non versionnés
certificates/codesigning/leaves/**/*.key.pem
certificates/codesigning/leaves/**/*.csr.pem
certificates/codesigning/leaves/**/*.pfx
certificates/**/*.pfx

# Node.js
node_modules/
