<Project>

  <!--
    Signature Authenticode des binaires à la compilation.
    Chaque projet signe sa sortie ($(TargetPath)) avec SON certificat de
    signature de code (certificates\codesigning\leaves\<Projet>\), via signtool
    (SDK Windows). Les clés privées n'étant pas versionnées, il faut d'abord
    générer les certificats : certificates\codesigning\leaves\regenerate-leaves.ps1.

    Comportement :
      - PFX du projet absent  → binaire non signé (message d'information).
      - PFX présent, signtool introuvable → ERREUR de build (exigence stricte).
      - Désactivation : -p:DiploWalkerSignOutputAfterBuild=false (ex. CI sans clés).
      - Horodatage : -p:DiploWalkerCodeSigningTimestampUrl=http://timestamp.digicert.com
    -->

  <PropertyGroup>
    <DiploWalkerCodeSigningLeaves>$(MSBuildThisFileDirectory)certificates\codesigning\leaves</DiploWalkerCodeSigningLeaves>
    <DiploWalkerSignOutputAfterBuild>true</DiploWalkerSignOutputAfterBuild>
    <DiploWalkerCodeSigningTimestampUrl></DiploWalkerCodeSigningTimestampUrl>
    <DiploWalkerSigntoolExe></DiploWalkerSigntoolExe>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DiploWalkerCodeSigningTimestampUrl)' != ''">
    <DiploWalkerCodeSigningTimestampArgs>/tr $(DiploWalkerCodeSigningTimestampUrl) /td SHA256</DiploWalkerCodeSigningTimestampArgs>
  </PropertyGroup>

  <!-- Candidats signtool : SDK Windows installés, puis override -p:DiploWalkerSigntoolExe -->
  <ItemGroup>
    <DiploWalkerSigntoolCandidates Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\*\x64\signtool.exe" />
    <DiploWalkerSigntoolCandidates Include="$(ProgramFiles)\Windows Kits\10\bin\*\x64\signtool.exe" />
    <DiploWalkerSigntoolCandidates Include="$(DiploWalkerSigntoolExe)" Condition="'$(DiploWalkerSigntoolExe)' != ''" />
  </ItemGroup>

  <Target Name="DiploWalkerSignBinary" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(DiploWalkerSignOutputAfterBuild)' == 'true' and '$(TargetPath)' != ''">

    <!-- Certificat de signature propre au projet en cours de compilation -->
    <PropertyGroup>
      <DiploWalkerCodeSigningPfx>$(DiploWalkerCodeSigningLeaves)\$(MSBuildProjectName)\$(MSBuildProjectName).pfx</DiploWalkerCodeSigningPfx>
    </PropertyGroup>

    <!-- Pas de PFX (poste non initialisé ou CI) : pas de signature -->
    <PropertyGroup Condition="!Exists('$(DiploWalkerCodeSigningPfx)')">
      <DiploWalkerCodeSigningDisabled>true</DiploWalkerCodeSigningDisabled>
    </PropertyGroup>

    <Message Condition="'$(DiploWalkerCodeSigningDisabled)' == 'true'"
             Importance="normal"
             Text="DiploWalker : certificat de signature absent — $(DiploWalkerCodeSigningPfx). Binaire NON signé. Générer avec certificates\codesigning\leaves\regenerate-leaves.ps1." />

    <!-- Résolution de signtool : la dernière version installée est préférée -->
    <PropertyGroup Condition="'$(DiploWalkerCodeSigningDisabled)' != 'true' and '$(DiploWalkerSigntool)' == '' and '@(DiploWalkerSigntoolCandidates)' != ''">
      <DiploWalkerSigntoolList>@(DiploWalkerSigntoolCandidates, ';')</DiploWalkerSigntoolList>
    </PropertyGroup>
    <PropertyGroup Condition="'$(DiploWalkerSigntool)' == '' and '$(DiploWalkerSigntoolList)' != '' and $(DiploWalkerSigntoolList.Contains(&apos;;&apos;))">
      <DiploWalkerSigntool>$(DiploWalkerSigntoolList.Substring($([MSBuild]::Add($(DiploWalkerSigntoolList.LastIndexOf(&apos;;&apos;)), 1))))</DiploWalkerSigntool>
    </PropertyGroup>
    <PropertyGroup Condition="'$(DiploWalkerSigntool)' == '' and '$(DiploWalkerSigntoolList)' != '' and !$(DiploWalkerSigntoolList.Contains(&apos;;&apos;))">
      <DiploWalkerSigntool>$(DiploWalkerSigntoolList)</DiploWalkerSigntool>
    </PropertyGroup>

    <!-- Exigence stricte : la signature est obligatoire, signtool doit exister -->
    <Error Condition="'$(DiploWalkerCodeSigningDisabled)' != 'true' and '$(DiploWalkerSigntool)' == ''"
           Text="Signature de code : signtool.exe introuvable. Installez le SDK Windows ou positionnez -p:DiploWalkerSigntoolExe=... " />

    <Exec Condition="'$(DiploWalkerCodeSigningDisabled)' != 'true'"
          Command="&quot;$(DiploWalkerSigntool)&quot; sign /fd SHA256 /f &quot;$(DiploWalkerCodeSigningPfx)&quot; $(DiploWalkerCodeSigningTimestampArgs) &quot;$(TargetPath)&quot;" />
  </Target>

  <!--
    Signature des sorties publiées (PublishDir).
    La copie vers PublishDir se déroulant avant la cible ci-dessus, les DLL/EXE
    publiés restaient non signés. Cette cible signe après Publish tous les
    binaires Diplo* avec le certificat du projet publié.
    -->
  <Target Name="DiploWalkerSignPublishOutput" AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(DiploWalkerSignOutputAfterBuild)' == 'true' and '$(PublishDir)' != ''">

    <PropertyGroup>
      <DiploWalkerCodeSigningPfx>$(DiploWalkerCodeSigningLeaves)\$(MSBuildProjectName)\$(MSBuildProjectName).pfx</DiploWalkerCodeSigningPfx>
    </PropertyGroup>

    <PropertyGroup Condition="!Exists('$(DiploWalkerCodeSigningPfx)')">
      <DiploWalkerCodeSigningDisabled>true</DiploWalkerCodeSigningDisabled>
    </PropertyGroup>

    <Message Condition="'$(DiploWalkerCodeSigningDisabled)' == 'true'"
             Importance="normal"
             Text="DiploWalker : certificat de signature absent — publication non signée." />

    <PropertyGroup Condition="'$(DiploWalkerCodeSigningDisabled)' != 'true' and '$(DiploWalkerSigntool)' == '' and '@(DiploWalkerSigntoolCandidates)' != ''">
      <DiploWalkerSigntoolList>@(DiploWalkerSigntoolCandidates, ';')</DiploWalkerSigntoolList>
    </PropertyGroup>
    <PropertyGroup Condition="'$(DiploWalkerSigntool)' == '' and '$(DiploWalkerSigntoolList)' != '' and $(DiploWalkerSigntoolList.Contains(&apos;;&apos;))">
      <DiploWalkerSigntool>$(DiploWalkerSigntoolList.Substring($([MSBuild]::Add($(DiploWalkerSigntoolList.LastIndexOf(&apos;;&apos;)), 1))))</DiploWalkerSigntool>
    </PropertyGroup>
    <PropertyGroup Condition="'$(DiploWalkerSigntool)' == '' and '$(DiploWalkerSigntoolList)' != '' and !$(DiploWalkerSigntoolList.Contains(&apos;;&apos;))">
      <DiploWalkerSigntool>$(DiploWalkerSigntoolList)</DiploWalkerSigntool>
    </PropertyGroup>

    <Error Condition="'$(DiploWalkerCodeSigningDisabled)' != 'true' and '$(DiploWalkerSigntool)' == ''"
           Text="Signature de code : signtool.exe introuvable. Installez le SDK Windows ou positionnez -p:DiploWalkerSigntoolExe=... " />

    <ItemGroup Condition="'$(DiploWalkerCodeSigningDisabled)' != 'true'">
      <DiploWalkerPublishFiles Include="$(PublishDir)Diplo*.dll;$(PublishDir)Diplo*.exe" />
    </ItemGroup>

    <Exec Condition="'$(DiploWalkerCodeSigningDisabled)' != 'true' and '@(DiploWalkerPublishFiles)' != ''"
          Command="&quot;$(DiploWalkerSigntool)&quot; sign /fd SHA256 /f &quot;$(DiploWalkerCodeSigningPfx)&quot; $(DiploWalkerCodeSigningTimestampArgs) &quot;%(DiploWalkerPublishFiles.FullPath)&quot;" />
  </Target>

</Project>
