<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning : force les versions des dépendances transitives
      à matcher les PackageVersion ci-dessous. Permet de corriger les CVE
      (Cryptography.Xml, Cryptography.Pkcs) sans PackageReference explicite
      (évite NU1510 sur les paquets du SDK).
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Grpc.AspNetCore.HealthChecks" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageVersion Include="Grpc.Core.Testing" Version="2.46.6" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.0" />
    <PackageVersion Include="protobuf-net" Version="3.4.19" />
    <PackageVersion Include="protobuf-net.Grpc" Version="1.3.14" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="10.0.652802" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FSharp.Core" Version="10.1.400" />
    <PackageVersion Include="FsUnit.xUnit" Version="7.1.1" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.1" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="LTRData.DiscUtils" Version="1.0.88" />
    <PackageVersion Include="Hawkynt.FileFormats.FileSystems" Version="1.0.0.776" />
  </ItemGroup>
</Project>