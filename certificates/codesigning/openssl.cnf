# Configuration de l'intermédiaire "CodeSigning" (parent : la racine).
# Autorité chargée de la signature de code.
# pathlen:0 : aucun autre intermédiaire en dessous, uniquement des feuilles.
#
# Exemples :
#   # Génération de la clé et de la CSR
#   openssl req  -new -config openssl.cnf -key private/codesigning.key.pem \
#                -out csr/codesigning.csr.pem
#   # Signature par la racine (exécutée depuis root-ca/)
#   openssl ca   -config ../root-ca/openssl.cnf -extensions v3_intermediate_leaf \
#                -in csr/codesigning.csr.pem -out certs/codesigning.crt.pem
#   # Signature d'un certificat feuille de signature de code
#   openssl ca   -config openssl.cnf -extensions leaf_cert \
#                -in ../leaf-codesigning/csr/leaf-codesigning.csr.pem \
#                -out ../leaf-codesigning/certs/leaf-codesigning.crt.pem

[ req ]
default_bits       = 8192
default_md         = sha384
distinguished_name = req_distinguished_name
string_mask        = utf8only
prompt             = no

[ req_distinguished_name ]
countryName            = FR
organizationName       = Diplo
organizationalUnitName = Diplo PKI Signature de code
commonName             = CodeSigning

[ ca ]
default_ca = CA_default

[ CA_default ]
dir            = .
database       = db/index.txt
new_certs_dir  = db/newcerts
certificate    = certs/codesigning.crt.pem
private_key    = private/codesigning.key.pem
serial         = db/serial
crlnumber      = db/crlnumber
crl_dir        = crl
default_md     = sha384
default_days   = 825
policy         = policy_codesigning
email_in_dn    = no
unique_subject = no
copy_extensions = copy

[ policy_codesigning ]
countryName            = supplied
organizationName       = supplied
organizationalUnitName = optional
commonName             = supplied

# Extensions des certificats feuilles signés par cette autorité.
[ leaf_cert ]
basicConstraints       = critical, CA:FALSE
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always, issuer
