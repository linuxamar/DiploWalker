<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NoneDriverTests.fs" />
    <Compile Include="PodDriverTests.fs" />
    <Compile Include="CustomCniDriverTests.fs" />
    <Compile Include="BridgeDriverTests.fs" />
    <Compile Include="CniParsingTests.fs" />
    <Compile Include="MockNetworkDriver.fs" />
    <Compile Include="NetworkServiceImplTests.fs" />
    <Compile Include="NetworkConfigTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"  />
    <PackageReference Include="xunit.v3"  />
    <PackageReference Include="xunit.runner.visualstudio" >
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsUnit.xUnit"  />
    <PackageReference Include="Grpc.Core.Testing"  />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Diplo.Abstractions\Diplo.Abstractions.fsproj" />
    <ProjectReference Include="..\..\src\Diplo.Network\Diplo.Network.fsproj" />
    <ProjectReference Include="..\..\src\Diplo.Grpc\Diplo.Grpc.fsproj" />
  </ItemGroup>

</Project>
