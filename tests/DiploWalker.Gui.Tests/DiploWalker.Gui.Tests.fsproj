<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ViewModelBaseTests.fs" />
    <Compile Include="AvaloniaOutputPortTests.fs" />
    <Compile Include="TabViewModelTests.fs" />
    <Compile Include="FakeStorageProvider.fs" />
    <Compile Include="OptionalBehaviorTests.fs" />
    <Compile Include="ClientInjectedBehaviorTests.fs" />
    <Compile Include="ImagesTabViewModelTests.fs" />
    <Compile Include="CatalogViewModelTests.fs" />
    <Compile Include="HeadlessApp.fs" />
    <Compile Include="HeadlessBehaviorTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"  />
    <PackageReference Include="FSharp.Core"  />
    <PackageReference Include="xunit.v3"  />
    <PackageReference Include="xunit.runner.visualstudio" >
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FsUnit.xUnit"  />
    <PackageReference Include="Avalonia.Headless"  />
    <!--
      Le paquet Avalonia est rÃ©fÃ©rencÃ© directement uniquement pour exposer la
      propriÃ©tÃ© MSBuild $(PkgAvalonia) (chemin du cache NuGet), utilisÃ©e par la
      cible UseLibAvaloniaBase juste en dessous.
    -->
    <PackageReference Include="Avalonia"  />
  </ItemGroup>

  <!--
    Contournement FS0366 : Avalonia fournit des rÃ©fÃ©rences assemblies
    (ref\net10.0) dont les mÃ©tadonnÃ©es dÃ©clenchent une erreur fantÃ´me
    Â« Aucune implÃ©mentation pour 'IStorageItem.(... is -not- implementable
    by user code ...)' Â» quand F# implÃ©mente les interfaces IStorageItem /
    IStorageFile / IStorageFolder / IStorageProvider (cf. FakeStorageProvider.fs).
    On remplace donc uniquement l'asset de compilation Avalonia.Base par son
    assembly lib\net10.0, qui ne prÃ©sente pas ce problÃ¨me.
  -->
  <Target Name="UseLibAvaloniaBase" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(ResolvedCompileFileDefinitions.Filename)' == 'Avalonia.Base'" />
      <Reference Include="Avalonia.Base">
        <HintPath>$(PkgAvalonia)\lib\net10.0\Avalonia.Base.dll</HintPath>
      </Reference>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiploWalker.Gui\DiploWalker.Gui.fsproj" />
    <ProjectReference Include="..\DiploWalker.TestHelpers\DiploWalker.TestHelpers.fsproj" />
  </ItemGroup>

</Project>

