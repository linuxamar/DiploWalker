<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AuthTokenTests.fs" />
    <Compile Include="TokenInterceptorTests.fs" />
    <Compile Include="TokenAuthMiddlewareTests.fs" />
    <Compile Include="SecurityValidationTests.fs" />
    <Compile Include="ServiceGuardsTests.fs" />
    <Compile Include="CachedConfigTests.fs" />
    <Compile Include="JsonHelpersTests.fs" />
    <Compile Include="DiploJsonTests.fs" />
    <Compile Include="ProcessExecTests.fs" />
    <Compile Include="NetworkConfigTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"  />
    <PackageReference Include="FSharp.Core"  />
    <PackageReference Include="xunit.v3"  />
    <PackageReference Include="xunit.runner.visualstudio" >
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FsUnit.xUnit"  />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Diplo.Abstractions\Diplo.Abstractions.fsproj" />
  </ItemGroup>

</Project>
