# Git LFS tracking
# Généré pour le dépôt Diplo. Les motifs ci-dessous stockent les fichiers
# correspondants via Git LFS (filter=lfs diff=lfs merge=lfs -text).

# --- Images & médias ---
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.ico    filter=lfs diff=lfs merge=lfs -text
*.bmp    filter=lfs diff=lfs merge=lfs -text
*.tif    filter=lfs diff=lfs merge=lfs -text
*.tiff   filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.svg    filter=lfs diff=lfs merge=lfs -text
*.pdf    filter=lfs diff=lfs merge=lfs -text

# --- Archives & binaires ---
*.zip    filter=lfs diff=lfs merge=lfs -text
*.7z     filter=lfs diff=lfs merge=lfs -text
*.rar    filter=lfs diff=lfs merge=lfs -text
*.gz     filter=lfs diff=lfs merge=lfs -text
*.tar    filter=lfs diff=lfs merge=lfs -text
*.dll    filter=lfs diff=lfs merge=lfs -text
*.exe    filter=lfs diff=lfs merge=lfs -text
*.msi    filter=lfs diff=lfs merge=lfs -text
*.lib    filter=lfs diff=lfs merge=lfs -text
*.so     filter=lfs diff=lfs merge=lfs -text
*.dylib  filter=lfs diff=lfs merge=lfs -text

# --- Office & data ---
*.xls    filter=lfs diff=lfs merge=lfs -text
*.xlsx   filter=lfs diff=lfs merge=lfs -text
*.doc    filter=lfs diff=lfs merge=lfs -text
*.docx   filter=lfs diff=lfs merge=lfs -text
*.ppt    filter=lfs diff=lfs merge=lfs -text
*.pptx   filter=lfs diff=lfs merge=lfs -text
*.mdf    filter=lfs diff=lfs merge=lfs -text
*.ldf    filter=lfs diff=lfs merge=lfs -text
*.bak    filter=lfs diff=lfs merge=lfs -text

# --- Assets signés (C3): fins de ligne LF obligatoires.
# La signature RSA-4096/SHA-384 couvre les octets exacts de ces fichiers ;
# toute conversion autocrlf casserait la vérification côté installateur. ---
src/DiploWalker.Installer/assets/artifacts.manifest      text eol=lf
src/DiploWalker.Installer/assets/artifacts.manifest.sig  text eol=lf
src/DiploWalker.Installer/assets/DiploWalker-release.pub text eol=lf

# --- Certificats TLS leaf-tls-server : LF obligatoire ---------------------
# Comme pour les assets signés, les fichiers de la PKI TLS doivent rester en LF
# pour éviter les problèmes avec OpenSSL et la vérification d'empreinte.
certificates/leaf-tls-server/**    text eol=lf

# --- PKI X509 : matériel secret chiffré par git-crypt ------------------------
# Les clés privées et les PFX de signature sont versionnés pour que la CI
# (job `release`) puisse signer les binaires et l'installateur. git-crypt les
# chiffre au repos dans l'index et le worktree : le dépôt ne contient que du
# ciphertext, la clé de déchiffrement est un secret hors dépôt.
# Voir certificates/README.md pour la distribution de la clé.
#
# Ce bloc doit rester APRÈS `certificates/leaf-tls-server/**` : en gitattributes
# le dernier motif qui correspond l'emporte, or la règle TLS ci-dessus fixe
# `text eol=lf` sur tout ce répertoire, y compris sur la clé privée qui est
# elle-même chiffrée. Le ciphertext étant binaire, il contient au moins une
# séquence CRLF : sans `-text`, `git status` normalise CRLF->LF, calcule un
# hash différent de celui de l'index et déclare le fichier modifié. `git-crypt
# unlock` refuse alors de démarrer (« Error: Working directory not clean. »).
# `-text` coupe toute conversion de fin de ligne sur les fichiers chiffrés ;
# git-crypt réécrit le contenu déchiffré à l'octet près, la normalisation n'a
# donc rien à faire ici. La même protection vaut pour les autres clés, qui ne
# portent pas `text` et héritent donc de core.autocrlf sur le runner.
# Aucun recouvrement avec les motifs Git LFS (*.pem et *.pfx n'y figurent pas) :
# les deux filtres ne se disputent jamais un même fichier.
certificates/**/*.key.pem   filter=git-crypt diff=git-crypt merge=git-crypt -text
certificates/**/*.pfx       filter=git-crypt diff=git-crypt merge=git-crypt -text

.gitattributes    text eol=lf
