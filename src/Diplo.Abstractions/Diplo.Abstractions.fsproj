<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Serilog" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Interfaces.fs" />
    <Compile Include="Security.fs" />
    <Compile Include="AuthToken.fs" />
    <Compile Include="TokenAuthMiddleware.fs" />
    <Compile Include="TokenInterceptor.fs" />
    <Compile Include="ServerConfig.fs" />
    <Compile Include="NetworkConfig.fs" />
  </ItemGroup>

</Project>
