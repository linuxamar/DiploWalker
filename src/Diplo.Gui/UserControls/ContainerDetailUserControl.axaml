<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:CompileBindings="False">

  <Border BorderThickness="1" CornerRadius="4"
          Margin="0,0,0,4">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Détails du conteneur" FontWeight="Bold"
                 Margin="10,8,0,6" FontSize="13" Opacity="0.9"/>

      <!-- Placeholder quand aucun conteneur sélectionné -->
      <TextBlock DockPanel.Dock="Top" Text="Sélectionnez un conteneur dans la liste"
                 HorizontalAlignment="Center" Margin="0,30" FontSize="13"
                 Opacity="0.4"
                 IsVisible="{Binding ContainerTab.HasSelection, Converter={x:Static BoolConverters.Not}}"/>

      <!-- Panneau détail (visible quand sélectionné) -->
      <StackPanel IsVisible="{Binding ContainerTab.HasSelection}" Margin="0,0,0,8">

        <!-- Propriétés du conteneur -->
        <Grid ColumnDefinitions="Auto,*,8,Auto,*" RowDefinitions="Auto,Auto,Auto"
              Margin="10,0,10,6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="ID :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="0" Grid.Column="1"
                     Text="{Binding ContainerTab.SelectedContainer.Id}"
                     Margin="0,0,0,3" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ContainerTab.SelectedContainer.Id}"/>

          <TextBlock Grid.Row="0" Grid.Column="3" Text="Nom :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="0" Grid.Column="4"
                     Text="{Binding ContainerTab.SelectedContainer.Nom}"
                     Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Image :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="1"
                     Text="{Binding ContainerTab.SelectedContainer.Image}"
                     Margin="0,0,0,3" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ContainerTab.SelectedContainer.Image}"/>

          <TextBlock Grid.Row="1" Grid.Column="3" Text="État :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="4"
                     Text="{Binding ContainerTab.SelectedContainer.État}"
                     Margin="0,0,0,3"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Créé le :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                     Text="{Binding ContainerTab.SelectedContainer.CrééLe}"
                     Margin="0,0,0,0"/>
        </Grid>

        <!-- Séparateur -->
        <Separator Margin="10,4,10,6"/>

        <!-- Actions sur le conteneur sélectionné -->
        <WrapPanel Margin="10,0,0,6">
          <Button Content="▶ Démarrer" Command="{Binding ContainerTab.StartContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="⏹ Arrêter" Command="{Binding ContainerTab.StopContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="🗑 Supprimer" Command="{Binding ContainerTab.DeleteContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="✏ Renommer" Command="{Binding ContainerTab.RenameContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="⚙ Processus" Command="{Binding ContainerTab.TopContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="📊 Métriques" Command="{Binding ContainerTab.StatsContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
        </WrapPanel>

        <!-- Configuration -->
        <WrapPanel Margin="10,0,0,6">
          <TextBlock Text="Nouveau nom :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerNewName}" Width="140"
                   Margin="0,0,12,4" PlaceholderText="renommer"/>
          <TextBlock Text="Montages :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerMounts}" Width="320"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                   PlaceholderText="src=C:\data,dst=/data[,ro]"/>
        </WrapPanel>

        <!-- Séparateur -->
        <Separator Margin="10,4,10,6"/>

        <!-- Logs & Exec -->
        <WrapPanel Margin="10,0,0,0">
          <Button Content="📜 Journaux" Command="{Binding ContainerTab.GetContainerLogsCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <CheckBox Content="Suivre" IsChecked="{Binding ContainerTab.ContainerFollow}"
                    Margin="8,0,0,4" VerticalAlignment="Center"/>
          <TextBlock Text="Lignes :" VerticalAlignment="Center" Margin="8,0,4,4"
                     Opacity="0.7"/>
          <NumericUpDown Value="{Binding ContainerTab.ContainerTail}" Minimum="10"
                         Maximum="10000" Width="80" Margin="0,0,12,4"/>
          <Button Content="⚡ Exécuter" Command="{Binding ContainerTab.ExecInContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <TextBlock Text="Cmd :" VerticalAlignment="Center" Margin="8,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerExecCommand}" Width="200"
                   Margin="0,0,0,4" PlaceholderText="commande à exécuter"/>
        </WrapPanel>

        <!-- Séparateur -->
        <Separator Margin="10,4,10,6"/>

        <!-- Images -->
        <WrapPanel Margin="10,0,0,6">
          <TextBlock Text="Réf. image :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerImageRef}" Width="200"
                   Margin="0,0,12,4" PlaceholderText="image:tag (inspect/remove/tag)"/>
          <TextBlock Text="Cible :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerImageTarget}" Width="200"
                   Margin="0,0,12,4" PlaceholderText="nouveau:tag (tag)"/>
          <Button Content="📋 Lister" Command="{Binding ContainerTab.ListImagesCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="🔍 Inspecter" Command="{Binding ContainerTab.InspectImageCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="🗑 Supprimer" Command="{Binding ContainerTab.RemoveImageCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="🏷 Étiqueter" Command="{Binding ContainerTab.TagImageCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
        </WrapPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="10,0,10,4">
          <DataGrid Grid.Column="0" ItemsSource="{Binding ContainerTab.Images}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                    CanUserSortColumns="True" MaxHeight="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Référentiel" Binding="{Binding Référentiel}" Width="280" />
              <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="140" />
              <DataGridTextColumn Header="Taille" Binding="{Binding Taille}" Width="120" />
              <DataGridTextColumn Header="Créé le" Binding="{Binding CrééLe}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                        Margin="4,0,0,0"/>
        </Grid>

      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
