<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>

  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RegistryAuth.fs" />
    <Compile Include="ContainerLogs.fs" />
    <Compile Include="Clients\ProcessRunner.fs" />
    <Compile Include="Clients\ContainerdClient.fs" />
    <Compile Include="Services\RegistrySearch.fs" />
    <Compile Include="Services\ContainerServiceImpl.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diplo.Contracts\Diplo.Contracts.fsproj" />
    <ProjectReference Include="..\Diplo.Abstractions\Diplo.Abstractions.fsproj" />
    <ProjectReference Include="..\Diplo.Grpc\Diplo.Grpc.fsproj" />
    <ProjectReference Include="..\Diplo.Disk\Diplo.Disk.fsproj" />
  </ItemGroup>
</Project>
