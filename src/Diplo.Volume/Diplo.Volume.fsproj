<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableDefaultProtobufItems>false</EnableDefaultProtobufItems>
    <Protobuf_ProjectSupported>true</Protobuf_ProjectSupported>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Drivers\LocalDriver.fs" />
    <Compile Include="Services\VolumeServiceImpl.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diplo.Contracts\Diplo.Contracts.fsproj" />
    <ProjectReference Include="..\Diplo.Abstractions\Diplo.Abstractions.fsproj" />
    <ProjectReference Include="..\Diplo.Grpc\Diplo.Grpc.csproj" />
  </ItemGroup>
</Project>
