<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SpectreOutputPort.fs" />
    <Compile Include="TypeRegistrar.fs" />
    <Compile Include="ContainerCommands.fs" />
    <Compile Include="VolumeCommands.fs" />
    <Compile Include="NetworkCommands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diplo.Core\Diplo.Core.fsproj" />
  </ItemGroup>

</Project>
