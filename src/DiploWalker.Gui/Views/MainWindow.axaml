<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiploWalker.Gui.ViewModels"
        xmlns:uc="using:DiploWalker.Gui.UserControls"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="Diplo — Gestion Docker"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Exporter le journal…" Command="{Binding ExportLogCommand}" />
                <MenuItem Header="_Quitter" Command="{Binding QuitCommand}" />
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem x:Name="AboutMenuItem" Header="_À propos" />
            </MenuItem>
        </Menu>

        <Grid RowDefinitions="*,5,Auto">
            <TabControl Grid.Row="0" Margin="4">
            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="🖼"/><TextBlock Text=" Images" Margin="4,0,0,0"/></StackPanel></TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button Content="🔄 Lister" Command="{Binding ImagesTab.ListImagesCommand}" Margin="0,0,4,0" />
                        <TextBox Text="{Binding ImagesTab.ImageSearchInput}" Width="220" Margin="0,0,12,0"
                                 x:Name="ImageSearchBox" MaxLength="120"
                                 PlaceholderText="🔍 Rechercher (docker.io, quay.io, ghcr.io, mcr.microsoft.com)…" />
                        <TextBox Text="{Binding ImagesTab.RegistreInput}" Width="150" Margin="0,0,12,0"
                                 x:Name="RegistreSearchBox" MaxLength="80"
                                 PlaceholderText="Registre (vide = tous)" />
                        <Button Content="📥 Télécharger" Command="{Binding ImagesTab.PullImageCommand}" Margin="0,0,4,0" />
                        <Button Content="🔍 Inspecter" Command="{Binding ImagesTab.InspectImageCommand}" Margin="0,0,4,0" />
                        <Button Content="✏ Étiqueter" Command="{Binding ImagesTab.TagImageCommand}" Margin="0,0,4,0" />
                        <Button Content="🗑 Supprimer" Command="{Binding ImagesTab.RemoveImageCommand}" Margin="0,0,4,0" />
                        <Button Content="🧹 Nettoyer" Command="{Binding ImagesTab.PruneImagesCommand}" Margin="0,0,4,0" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Réf. télécharger:" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ImagesTab.PullRefInput}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="nom:tag" />
                        <TextBlock Text="User (pull):" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ImagesTab.PullUserInput}" Width="120" Margin="0,0,12,0"
                                 PlaceholderText="user:pass" />
                        <TextBlock Text="Espace:" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ImagesTab.ImageNsInput}" Width="120" Margin="0,0,12,0"
                                 PlaceholderText="namespace" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Source étiqueter:" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ImagesTab.TagSourceInput}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="source:tag" />
                        <TextBlock Text="Cible étiqueter:" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ImagesTab.TagTargetInput}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="cible:tag" />
                        <TextBlock Text="Réf. (inspecter/suppr.):" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Opacity="0.7" />
                        <TextBox Text="{Binding ImagesTab.ImageRefInput}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="réf. image (sinon sélection)" />
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding ImagesTab.Images}" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" CanUserSortColumns="True"
                              SelectedItem="{Binding ImagesTab.SelectedImage}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Référentiel" Binding="{Binding Ref}" Width="200" />
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="120" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="120" />
                            <DataGridTextColumn Header="Créé le" Binding="{Binding CreatedAt}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="📥 Tirer la sélection"
                                    Command="{Binding ImagesTab.SearchResultPullCommand}" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding ImagesTab.SearchStatus}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding ImagesTab.SearchResults}" AutoGenerateColumns="False"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  CanUserResizeColumns="True" CanUserSortColumns="True"
                                  MaxHeight="220" SelectedItem="{Binding ImagesTab.SelectedSearchResult}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Registre" Binding="{Binding Registre}" Width="140" />
                                <DataGridTextColumn Header="Référence" Binding="{Binding Ref}" Width="260" />
                                <DataGridTextColumn Header="Étoiles" Binding="{Binding Stars}" Width="80" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="🐳"/><TextBlock Text=" Conteneurs" Margin="4,0,0,0"/></StackPanel></TabItem.Header>
                <DockPanel>
                    <!-- Toolbar principal -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button Content="🔄 Lister" Command="{Binding ContainerTab.ListContainersCommand}" Margin="0,0,4,0" />
                        <Button Content="➕ Créer" Command="{Binding ContainerTab.CreateContainerCommand}" Margin="0,0,4,0" />
                        <Button Content="📥 Télécharger" Command="{Binding ContainerTab.PullImageCommand}" Margin="0,0,4,0" />
                        <Button Content="🔍 Inspecter" Command="{Binding ContainerTab.InspectContainerCommand}" Margin="0,0,12,0" />
                        <Button Content="📁 Espaces" Command="{Binding ContainerTab.ListNamespacesCommand}" Margin="0,0,4,0" />
                        <Button Content="ℹ Version" Command="{Binding ContainerTab.VersionCommand}" Margin="0,0,8,0" />
                        <Button Content="🧹 Nettoyer" Command="{Binding ContainerTab.PruneContainersCommand}" Margin="0,0,8,0" />
                        <Button Content="📢 Événements" Command="{Binding ContainerTab.GetContainerEventsCommand}" Margin="0,0,4,0" />
                        <Button Content="⏹ Arrêter" Command="{Binding ContainerTab.StopFollowEventsCommand}" />
                    </WrapPanel>

                    <!-- Champs de création / recherche -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="ID :" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ContainerTab.ContainerIdInput}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="identifiant du conteneur" />
                        <TextBlock Text="Nom :" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ContainerTab.ContainerNameInput}" Width="140" Margin="0,0,12,0"
                                 PlaceholderText="nom (optionnel)" />
                        <TextBlock Text="Image :" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ContainerTab.ContainerImageInput}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="nom:tag" />
                        <TextBlock Text="User (pull) :" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ContainerTab.ContainerImageUser}" Width="120" Margin="0,0,12,0"
                                 PlaceholderText="user:pass" />
                        <TextBlock Text="Espace :" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <TextBox Text="{Binding ContainerTab.ContainerNamespace}" Width="120" Margin="0,0,12,0"
                                 PlaceholderText="namespace" />
                        <TextBlock Text="Timeout :" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <NumericUpDown Value="{Binding ContainerTab.ContainerTimeout}" Minimum="1" Maximum="300"
                                       Width="70" />
                        <CheckBox Content="Tous" IsChecked="{Binding ContainerTab.ContainerAll}" Margin="12,0,0,0"
                                  VerticalAlignment="Center" />
                        <CheckBox Content="Forcer" IsChecked="{Binding ContainerTab.ContainerForce}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Zone principale : DataGrid + Détail -->
                    <Grid ColumnDefinitions="*,4,*" Margin="0,0,0,4">
                        <!-- DataGrid Conteneurs -->
                        <DataGrid Grid.Column="0" ItemsSource="{Binding ContainerTab.Containers}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  SelectedItem="{Binding ContainerTab.SelectedContainer}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="140" />
                                <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="180" />
                                <DataGridTextColumn Header="État" Binding="{Binding State}" Width="80" />
                                <DataGridTextColumn Header="Créé le" Binding="{Binding CreatedAt}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                      ResizeDirection="Columns"
                                      Background="{DynamicResource SystemChromeGrayColor}" />

                        <!-- Détail du conteneur sélectionné -->
                        <uc:ContainerDetailUserControl Grid.Column="2" />
                    </Grid>

                </DockPanel>
            </TabItem>

            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="📁"/><TextBlock Text=" Volumes" Margin="4,0,0,0"/></StackPanel></TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button Content="🔄 Lister" Command="{Binding VolumeTab.ListVolumesCommand}" Margin="0,0,4,0" />
                        <Button Content="🔍 Inspecter" Command="{Binding VolumeTab.InspectVolumeCommand}" Margin="0,0,4,0" />
                        <Button Content="➕ Créer" Command="{Binding VolumeTab.CreateVolumeCommand}" Margin="0,0,4,0" />
                        <Button Content="🗑 Supprimer" Command="{Binding VolumeTab.RemoveVolumeCommand}" Margin="0,0,4,0" />
                        <Button Content="📁 Monter" Command="{Binding VolumeTab.MountVolumeCommand}" Margin="0,0,4,0" />
                        <Button Content="📂 Démonter" Command="{Binding VolumeTab.UnmountVolumeCommand}" Margin="0,0,4,0" />
                        <Button Content="🧹 Nettoyer" Command="{Binding VolumeTab.PruneVolumesCommand}" Margin="0,0,4,0" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="ID:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding VolumeTab.VolumeIdInput}" Width="200" Margin="0,0,12,0"
                                 PlaceholderText="identifiant du volume" />
                        <TextBlock Text="Nom:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding VolumeTab.VolumeNameInput}" Width="160" Margin="0,0,12,0"
                                 PlaceholderText="nom du volume" />
                        <TextBlock Text="Driver:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding VolumeTab.VolumeDriver}" Width="100" Margin="0,0,12,0"
                                 PlaceholderText="local" />
                        <TextBlock Text="Cible:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding VolumeTab.VolumeTargetPath}" Width="200" Margin="0,0,12,0"
                                 PlaceholderText="chemin de montage" />
                        <CheckBox Content="Forcer" IsChecked="{Binding VolumeTab.VolumeForce}" Margin="12,0,0,0"
                                  VerticalAlignment="Center" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Rép. source:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding VolumeTab.ImageSourceDir}" Width="200" Margin="0,0,4,0"
                                 PlaceholderText="chemin vers le répertoire source" />
                        <Button Content="…" Command="{Binding VolumeTab.BrowseSourceCommand}" Width="28" Margin="0,0,12,0" />
                        <TextBlock Text="Destination:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding VolumeTab.ImageDestPath}" Width="200" Margin="0,0,4,0"
                                 PlaceholderText="chemin de l'image à créer" />
                        <Button Content="…" Command="{Binding VolumeTab.BrowseDestCommand}" Width="28" Margin="0,0,12,0" />
                        <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding VolumeTab.ImageFormat}" Width="80" Margin="0,0,12,0"
                                 PlaceholderText="raw" />
                        <Button Content="🖼 Créer image" Command="{Binding VolumeTab.CreateImageCommand}" Margin="0,0,4,0" />
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding VolumeTab.Volumes}" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="160" />
                            <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="80" />
                            <DataGridTextColumn Header="Point de montage" Binding="{Binding PointDeMontage}" Width="240" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="🌐"/><TextBlock Text=" Réseaux" Margin="4,0,0,0"/></StackPanel></TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button Content="🔄 Lister" Command="{Binding NetworkTab.ListNetworksCommand}" Margin="0,0,4,0" />
                        <Button Content="🔍 Inspecter" Command="{Binding NetworkTab.InspectNetworkCommand}" Margin="0,0,4,0" />
                        <Button Content="➕ Créer" Command="{Binding NetworkTab.CreateNetworkCommand}" Margin="0,0,4,0" />
                        <Button Content="🗑 Supprimer" Command="{Binding NetworkTab.RemoveNetworkCommand}" Margin="0,0,4,0" />
                        <Button Content="🔗 Connecter" Command="{Binding NetworkTab.ConnectNetworkCommand}" Margin="0,0,4,0" />
                        <Button Content="🔌 Déconnecter" Command="{Binding NetworkTab.DisconnectNetworkCommand}" Margin="0,0,4,0" />
                        <Button Content="⚙ Exécuter CNI" Command="{Binding NetworkTab.RunCniPluginCommand}" Margin="0,0,4,0" />
                        <Button Content="🧹 Nettoyer" Command="{Binding NetworkTab.PruneNetworksCommand}" Margin="0,0,4,0" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="ID:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkIdInput}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="identifiant réseau" />
                        <TextBlock Text="Nom:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkNameInput}" Width="140" Margin="0,0,12,0"
                                 PlaceholderText="nom du réseau" />
                        <TextBlock Text="Driver:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkDriver}" Width="100" Margin="0,0,12,0"
                                 PlaceholderText="bridge" />
                        <TextBlock Text="Sous-réseau:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkSubnet}" Width="140" Margin="0,0,12,0"
                                 PlaceholderText="172.20.0.0/16" />
                        <TextBlock Text="Passerelle:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkGateway}" Width="140" Margin="0,0,12,0"
                                 PlaceholderText="172.20.0.1" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Endpoint:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkEndpointId}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="ID endpoint (connect/déconnect)" />
                        <TextBlock Text="Conteneur:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkContainerId}" Width="180" Margin="0,0,12,0"
                                 PlaceholderText="ID conteneur" />
                        <TextBlock Text="IPv4:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkIpv4}" Width="140" Margin="0,0,12,0"
                                 PlaceholderText="172.20.0.2/16" />
                        <CheckBox Content="Forcer" IsChecked="{Binding NetworkTab.NetworkForce}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Plugin CNI:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkCniPluginPath}" Width="200" Margin="0,0,12,0"
                                 PlaceholderText="chemin vers plugin CNI" />
                        <TextBlock Text="Commande:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkCniCommand}" Width="80" Margin="0,0,12,0"
                                 PlaceholderText="ADD/DEL/CHECK" />
                        <TextBlock Text="NetNS:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding NetworkTab.NetworkNetnsPath}" Width="200" Margin="0,0,12,0"
                                 PlaceholderText="chemin namespace réseau" />
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding NetworkTab.Networks}" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="140" />
                            <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="80" />
                            <DataGridTextColumn Header="Sous-réseau" Binding="{Binding SousReseau}" Width="140" />
                            <DataGridTextColumn Header="Passerelle" Binding="{Binding Passerelle}" Width="120" />
                            <DataGridTextColumn Header="Créé le" Binding="{Binding CreatedAt}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="📝"/><TextBlock Text=" Compose" Margin="4,0,0,0"/></StackPanel></TabItem.Header>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button Content="▶ Démarrer" Command="{Binding ComposeTab.ComposeUpCommand}" Margin="0,0,4,0" />
                        <Button Content="⏹ Arrêter" Command="{Binding ComposeTab.ComposeDownCommand}" Margin="0,0,4,0" />
                        <Button Content="📋 État" Command="{Binding ComposeTab.ComposePsCommand}" Margin="0,0,4,0" />
                        <Button Content="📜 Journaux" Command="{Binding ComposeTab.ComposeLogsCommand}" Margin="0,0,4,0" />
                        <Button Content="📥 Télécharger" Command="{Binding ComposeTab.ComposePullCommand}" Margin="0,0,4,0" />
                        <Button Content="🔨 Construire" Command="{Binding ComposeTab.ComposeBuildCommand}" Margin="0,0,4,0" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button Content="📂 Ouvrir" Command="{Binding ComposeTab.OpenComposeFileCommand}" Margin="0,0,4,0" />
                        <Button Content="💾 Enregistrer" Command="{Binding ComposeTab.SaveComposeFileCommand}" Margin="0,0,4,0" />
                        <Button Content="✅ Valider" Command="{Binding ComposeTab.ValidateComposeFileCommand}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ComposeTab.ComposeEditor.FilePath}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Opacity="0.6" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Fichier:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding ComposeTab.ComposeFilePath}" Width="400" Margin="0,0,12,0"
                                 PlaceholderText="chemin vers docker-compose.yml" />
                        <TextBlock Text="Service:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding ComposeTab.ComposeServiceName}" Width="160" Margin="0,0,12,0"
                                 PlaceholderText="nom du service (optionnel)" />
                    </WrapPanel>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Réf. image:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding ComposeTab.InspectImageRef}" Width="200" Margin="0,0,12,0"
                                 PlaceholderText="image:tag (inspecter)" />
                        <Button Content="🔍 Inspecter img" Command="{Binding ComposeTab.InspectImageCommand}" Margin="0,0,4,0" />
                    </WrapPanel>

                    <Panel x:Name="ComposeEditorHost" DockPanel.Dock="Top" Height="250" />

                    <ListBox DockPanel.Dock="Top"
                             Height="80" Margin="0,4,0,4"
                             ItemsSource="{Binding ComposeTab.ComposeEditor.Errors}"
                             BorderThickness="1"
                             DisplayMemberBinding="{Binding Message}" />

                    <DataGrid ItemsSource="{Binding ComposeTab.ComposeServices}" AutoGenerateColumns="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal"
                              CanUserResizeColumns="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="120" />
                            <DataGridTextColumn Header="Conteneur" Binding="{Binding Conteneur}" Width="200" />
                            <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="200" />
                            <DataGridTextColumn Header="État" Binding="{Binding State}" Width="80" />
                            <DataGridTextColumn Header="Projet" Binding="{Binding Projet}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⚙"/><TextBlock Text=" Paramètres" Margin="4,0,0,0"/></StackPanel></TabItem.Header>
                <StackPanel Margin="12">
                    <TextBlock Text="Configuration client (DiploWalker.json)" FontWeight="Bold" />
                    <TextBlock Text="{Binding SettingsTab.ConfigPath}" TextWrapping="Wrap"
                               Margin="0,2,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Adresse conteneurs :" Width="150" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SettingsTab.ContainerAddress}" Width="360"
                                 PlaceholderText="localhost:5001" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Adresse volumes :" Width="150" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SettingsTab.VolumeAddress}" Width="360"
                                 PlaceholderText="localhost:5002" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Adresse réseaux :" Width="150" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SettingsTab.NetworkAddress}" Width="360"
                                 PlaceholderText="localhost:5003" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="💾 Enregistrer" Command="{Binding SettingsTab.SaveCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="🔄 Recharger" Command="{Binding SettingsTab.ReloadCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding SettingsTab.StatusMessage}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Remarque : la configuration enregistrée est appliquée aux prochaines opérations des onglets."
                               Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          Background="{DynamicResource SystemChromeGrayColor}" />

            <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Journal" FontWeight="Bold"
                               Margin="8,4,0,2" />
                    <ScrollViewer>
                        <TextBlock Text="{Binding LogOutput}"
                                   FontFamily="Cascadia Mono,Consolas"
                                   TextWrapping="Wrap" Margin="8,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
