<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiploWalker.Gui.ViewModels"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

  <Border BorderThickness="1" CornerRadius="4"
          Margin="0,0,0,4">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="DÃ©tails du conteneur" FontWeight="Bold"
                 Margin="10,8,0,6" FontSize="13" Opacity="0.9"/>

      <!-- Placeholder quand aucun conteneur sÃ©lectionnÃ© -->
      <TextBlock DockPanel.Dock="Top" Text="SÃ©lectionnez un conteneur dans la liste"
                 HorizontalAlignment="Center" Margin="0,30" FontSize="13"
                 Opacity="0.4"
                 IsVisible="{Binding ContainerTab.HasSelection, Converter={x:Static BoolConverters.Not}}"/>

      <!-- Panneau dÃ©tail (visible quand sÃ©lectionnÃ©) -->
      <StackPanel IsVisible="{Binding ContainerTab.HasSelection}" Margin="0,0,0,8">

        <!-- PropriÃ©tÃ©s du conteneur -->
        <Grid ColumnDefinitions="Auto,*,8,Auto,*" RowDefinitions="Auto,Auto,Auto"
              Margin="10,0,10,6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="ID :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="0" Grid.Column="1"
                     Text="{Binding ContainerTab.SelectedContainer.Id}"
                     Margin="0,0,0,3" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ContainerTab.SelectedContainer.Id}"/>

          <TextBlock Grid.Row="0" Grid.Column="3" Text="Nom :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="0" Grid.Column="4"
                     Text="{Binding ContainerTab.SelectedContainer.Nom}"
                     Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Image :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="1"
                     Text="{Binding ContainerTab.SelectedContainer.Image}"
                     Margin="0,0,0,3" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ContainerTab.SelectedContainer.Image}"/>

          <TextBlock Grid.Row="1" Grid.Column="3" Text="Ã‰tat :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,3" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="4"
                     Text="{Binding ContainerTab.SelectedContainer.State}"
                     Margin="0,0,0,3"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="CrÃ©Ã© le :" FontWeight="SemiBold"
                     Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                     Text="{Binding ContainerTab.SelectedContainer.CreatedAt}"
                     Margin="0,0,0,0"/>
        </Grid>

        <!-- SÃ©parateur -->
        <Separator Margin="10,4,10,6"/>

        <!-- Actions sur le conteneur sÃ©lectionnÃ© -->
        <WrapPanel Margin="10,0,0,6">
          <Button Content="â–¶ DÃ©marrer" Command="{Binding ContainerTab.StartContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="â¹ ArrÃªter" Command="{Binding ContainerTab.StopContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="â¸ Suspendre" Command="{Binding ContainerTab.PauseContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="â–¶ Reprendre" Command="{Binding ContainerTab.UnpauseContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="â³ Attendre" Command="{Binding ContainerTab.WaitContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ—‘ Supprimer" Command="{Binding ContainerTab.DeleteContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="âœ Renommer" Command="{Binding ContainerTab.RenameContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="âš™ Processus" Command="{Binding ContainerTab.TopContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ“Š MÃ©triques" Command="{Binding ContainerTab.StatsContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
        </WrapPanel>

        <!-- Configuration -->
        <WrapPanel Margin="10,0,0,6">
          <TextBlock Text="Nouveau nom :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerNewName}" Width="140"
                   Margin="0,0,12,4" PlaceholderText="renommer"/>
          <TextBlock Text="Montages :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerMounts}" Width="320"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                   PlaceholderText="src=C:\data,dst=/data[,ro]"/>
        </WrapPanel>

        <!-- SÃ©parateur -->
        <Separator Margin="10,4,10,6"/>

        <!-- Logs & Exec -->
        <WrapPanel Margin="10,0,0,0">
          <Button Content="ðŸ“œ Journaux" Command="{Binding ContainerTab.GetContainerLogsCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <CheckBox Content="Suivre" IsChecked="{Binding ContainerTab.ContainerFollow}"
                    Margin="8,0,0,4" VerticalAlignment="Center"/>
          <TextBlock Text="Lignes :" VerticalAlignment="Center" Margin="8,0,4,4"
                     Opacity="0.7"/>
          <NumericUpDown Value="{Binding ContainerTab.ContainerTail}" Minimum="10"
                         Maximum="10000" Width="80" Margin="0,0,12,4"/>
          <Button Content="âš¡ ExÃ©cuter" Command="{Binding ContainerTab.ExecInContainerCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <TextBlock Text="Cmd :" VerticalAlignment="Center" Margin="8,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerExecCommand}" Width="200"
                   Margin="0,0,0,4" PlaceholderText="commande Ã  exÃ©cuter"/>
        </WrapPanel>

        <!-- SÃ©parateur -->
        <Separator Margin="10,4,10,6"/>

        <!-- Images -->
        <WrapPanel Margin="10,0,0,6">
          <TextBlock Text="RÃ©f. image :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerImageRef}" Width="200"
                   Margin="0,0,12,4" PlaceholderText="image:tag (inspect/remove/tag)"/>
          <TextBlock Text="Cible :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerImageTarget}" Width="200"
                   Margin="0,0,12,4" PlaceholderText="nouveau:tag (tag/commit)"/>
          <Button Content="ðŸ“‹ Lister" Command="{Binding ContainerTab.ListImagesCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ” Inspecter" Command="{Binding ContainerTab.InspectImageCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ—‘ Supprimer" Command="{Binding ContainerTab.RemoveImageCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ· Ã‰tiqueter" Command="{Binding ContainerTab.TagImageCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ“¸ Committer" Command="{Binding ContainerTab.CommitImageCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ§¹ Nettoyer" Command="{Binding ContainerTab.PruneImagesCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
        </WrapPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="10,0,10,4">
          <DataGrid Grid.Column="0" ItemsSource="{Binding ContainerTab.Images}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                    CanUserSortColumns="True" MaxHeight="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="RÃ©fÃ©rentiel" Binding="{Binding Reference}" Width="280" />
              <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="140" />
              <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="120" />
              <DataGridTextColumn Header="CrÃ©Ã© le" Binding="{Binding CreatedAt}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                        ResizeDirection="Columns" Margin="4,0,0,0"
                        Background="{DynamicResource SystemChromeGrayColor}"/>
        </Grid>

        <Separator Margin="10,4,10,6"/>

        <!-- Catalogue d'images -->
        <WrapPanel Margin="10,0,0,6">
          <TextBlock Text="RÃ©f. image :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerImageRef}" Width="200"
                   Margin="0,0,12,4" PlaceholderText="image:tag (catalogue)"/>
          <TextBlock Text="Cible :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.ContainerImageTarget}" Width="200"
                   Margin="0,0,12,4" PlaceholderText="nouveau:tag (mise Ã  jour)"/>
          <TextBlock Text="Note :" VerticalAlignment="Center" Margin="0,0,4,4"
                     Opacity="0.7"/>
          <TextBox Text="{Binding ContainerTab.CatalogNote}" Width="200"
                   Margin="0,0,12,4" PlaceholderText="note optionnelle"/>
          <Button Content="ðŸ“‹ Lister" Command="{Binding ContainerTab.ListCatalogCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="âž• Inscrire" Command="{Binding ContainerTab.AddToCatalogCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="âœï¸ Mettre Ã  jour" Command="{Binding ContainerTab.UpdateCatalogCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
          <Button Content="ðŸ—‘ Retirer" Command="{Binding ContainerTab.RemoveFromCatalogCommand}"
                  Margin="0,0,4,4" Padding="8,4"/>
        </WrapPanel>

        <Grid ColumnDefinitions="*,Auto" Margin="10,0,10,4">
          <DataGrid Grid.Column="0" ItemsSource="{Binding ContainerTab.Catalogue}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                    CanUserSortColumns="True" MaxHeight="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="RÃ©fÃ©rence" Binding="{Binding Ref}" Width="280" />
              <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="200" />
              <DataGridTextColumn Header="AjoutÃ©" Binding="{Binding AddedAt}" Width="140" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                        ResizeDirection="Columns" Margin="4,0,0,0"
                        Background="{DynamicResource SystemChromeGrayColor}"/>
        </Grid>

      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
