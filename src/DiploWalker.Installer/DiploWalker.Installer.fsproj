<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DiploWalker.Installer</RootNamespace>
    <AssemblyName>DiploWalker.Installer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ArtifactSigning.fs" />
    <Compile Include="Core.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\artifacts.manifest" LogicalName="DiploWalker.Installer.assets.artifacts.manifest" />
    <EmbeddedResource Include="assets\artifacts.manifest.sig" LogicalName="DiploWalker.Installer.assets.artifacts.manifest.sig" />
    <EmbeddedResource Include="assets\DiploWalker-release.pub" LogicalName="DiploWalker.Installer.assets.DiploWalker-release.pub" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiploWalker.Abstractions\DiploWalker.Abstractions.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController"  />
    <PackageReference Include="FSharp.Core"  />
  </ItemGroup>

</Project>


